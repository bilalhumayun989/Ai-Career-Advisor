# Copy this file to .env and fill in the values. Never commit .env.
DATABASE_URL=postgresql://career_ai_user:change-this-password@127.0.0.1:5432/career_ai
JWT_SECRET=replace-with-a-long-random-secret
# Required for the OpenAI-based career recommendations endpoint.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna
